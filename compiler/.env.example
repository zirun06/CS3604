# Copy to .env; use a model that accepts image input.
MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
# DeepSeek text proposals and edits start without reasoning; repairs opt in.
# Other providers default to provider when MODEL_REASONING is unset.
MODEL_REASONING=none
MODEL_REPAIR_REASONING=low
VISUAL_REASONING=low
# Text response budget includes both reasoning and final output tokens.
MAX_OUTPUT_TOKENS=320000
# Stop the run after this many consecutive matching connection, authentication or pre-send failures.
COMPILER_MODEL_FAILURE_THRESHOLD=3
